# Copy to .env and adjust. Everything except the login has a default.

# ---- The web server ---------------------------------------------------------------------------------------------------------------------------
# Listen on the computer only (the Apache reverse proxy is in front of it).
HOST=127.0.0.1
PORT=3001

# Where the backend keeps its own files (the connection settings, the session secret).
DATA_DIR=./data

# ---- The login (required) ---------------------------------------------------------------------------------------------------------------------
# The user name, and the hash of the password. Make the hash with:  npm run hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# How long a login is valid (hours).
SESSION_HOURS=12

# ---- CamServer (the first start; changed later in the web UI on the Connection page, which is stored in DATA_DIR) ----------------------------
CAMSERVER_HOST=127.0.0.1
CAMSERVER_PORT=45651
# true: wss:// (only with a TLS proxy in front of CamServer, CamServer itself speaks plain ws).
CAMSERVER_SECURE=false

# The token of the remote control. Either directly, or the file, which CamServer made (CamServer/websocket_token.txt, same computer).
CAMSERVER_TOKEN=
CAMSERVER_TOKEN_FILE=

# ---- Optional ---------------------------------------------------------------------------------------------------------------------------------
# The recordings folder of CamServer (recordings_path). Makes the recordings downloadable in the web UI.
RECORDINGS_DIR=

# The built web UI (CamWeb: npm run build:export). If it exists, this server serves it too.
STATIC_DIR=../CamWeb/out

# Live view: pictures per second, and how many people may watch one camera at the same time.
STREAM_FPS=10
MAX_VIEWERS_PER_CAMERA=8
