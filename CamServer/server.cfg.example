# Copy this file to server.cfg (in the working directory of the server). Every setting can also be given as --key=value on the command line,
# which overrides this file. Use --config=path to load a different file. Settings that are not set use the defaults shown here.

# UDP port, on which the server listens.
port = 45645

# ---- Security --------------------------------------------------------------------------------------------------------------------------------
# Only cameras and displays with their own key may connect, and everything between them and the server is encrypted (AES-256) and protected
# against changes and replays. The keys are made on this computer, one for every device:
#   CamServer --add_device=camera --name="Front door"       prints the key for client.cfg of this camera (key = ...)
#   CamServer --add_device=display --name="Living room"     prints the key for display.cfg of this display
#   CamServer --list_devices                                shows the devices (never the keys)
#   CamServer --remove_device="Front door"                  takes the key away (a lost or stolen device), a running server ends its connection
# The server notices changes of the file while it is running, it does not have to be restarted. A key of a display cannot be used as a camera and the
# other way around, and a camera always has the name, which it was given with --add_device.
# false turns all of this off: everybody in the network can connect as a camera or as a display, and nothing is encrypted. Only for a network you trust,
# and for older programs without keys.
auth = true

# The file with the devices and their keys. It is a secret (whoever can read it can pretend to be a device), keep it out of backups and git.
devices_file = devices.cfg

# Minutes of video kept in memory per camera.
backup_minutes = 5

# Seconds without any message after which a client counts as gone (crashed, network down) and is removed, freeing its stored frames.
# Connected clients send a heartbeat every second, so idle clients are not affected. 0 disables the timeout.
client_timeout_seconds = 15

# Shows a live preview window for every connected camera.
preview = true

# ---- Recordings ------------------------------------------------------------------------------------------------------------------------------
# The server keeps the last backup_minutes of every camera in memory. These minutes can be saved as a video file at any time (see README, section
# Recordings): with the command CamServer --record_now=MINUTES, with the key R in a preview window, or automatically when an unknown person is seen.
# On top of that, it can record continuously at fixed times (a schedule), for example every night.
# The videos are AVI files (Motion JPEG), they play in VLC, Windows Media Player and most other players.

# The folder for the videos (one sub folder per camera).
recordings_path = recordings

# The times, at which everything is recorded. Empty = no scheduled recording. Windows are separated by semicolons. A window is an optional list of days
# (Mon, Tue, Wed, Thu, Fri, Sat, Sun, ranges like Mon-Fri, or lists like Mon,Wed,Fri; no days = every day) and a time range in the local time.
# A time range, which ends before it starts, goes over midnight (and belongs to the day, on which it starts).
# Examples:   22:00-06:00              every night
#             Mon-Fri 08:00-18:00      working hours on weekdays
#             Sat,Sun 00:00-23:59; Fri 18:00-23:59      all weekend
record_schedule =

# The cameras, which are recorded on schedule (names, separated by commas). Empty = all cameras.
record_cameras =

# A scheduled recording is split into files of this many minutes. A file is only playable when it is finished, so shorter files lose less, if the
# power fails, a file is also finished when it reaches 1.5 GB, when a camera is silent for a minute, and when the server stops with Ctrl+C.
record_segment_minutes = 10

# Old videos are deleted: older than this many days (0 = keep forever), and when all videos together are larger than this many gigabytes (0 = no limit),
# then the oldest ones go first. This protects the disk. Checked every 10 minutes.
record_keep_days = 14
record_max_gb = 20

# How many minutes the key R (preview window) saves.
record_default_minutes = 5

# Saves a video of a camera automatically, when it sees an unknown person (needs the face recognition). The event is in the MIDDLE of the video: it starts
# record_event_before_seconds before the event (taken from the buffer, so you see how the person came in) and ends record_event_after_seconds after it
# (the server waits for that time, then saves, so the file appears that many seconds after the alarm).
# If the person stays or comes back before the video is saved, it is made longer instead of making a second one, but it never gets longer than
# record_event_max_seconds after the first event. backup_minutes must be larger than before + after (+ 10 seconds).
# (record_event_minutes of older versions is not used anymore.)
record_on_unknown_person = false
record_event_before_seconds = 40
record_event_after_seconds = 45
record_event_max_seconds = 180

# The control port. A program on the same computer (never from the network) can tell the running server what to do:
#   CamServer --record_now=5                      saves the last 5 minutes of all cameras
#   CamServer --record_now=5 --record_camera=Front   only of the camera "Front"
#   CamServer --control_status                    shows the cameras, the buffers and the recording settings
#   CamServer --control_stop                      stops the server properly (finishes the recordings)
# 0 turns it off.
control_port = 45650

# ---- Remote control (WebSocket) --------------------------------------------------------------------------------------------------------------
# A WebSocket, over which the server is controlled with JSON commands: save the buffer of the cameras as videos, list the cameras, the displays and the
# recordings, manage the device keys, stop the server (see README, section Remote control). A program has to log in with the token first.
# 0 turns it off.
websocket_port = 45651

# 127.0.0.1: only programs on this computer can connect. 0.0.0.0: the whole network. Careful: the connection is NOT encrypted (the token and all
# answers travel as they are), so only use it in a network you trust, or through an SSH tunnel / a TLS proxy.
websocket_bind = 127.0.0.1

# The secret, which a program has to send to log in. Empty: the token is made on the first start and stored in websocket_token_file
# (CamServer --show_websocket_token prints it). Whoever has the token controls the server, keep it secret.
websocket_token =
websocket_token_file = websocket_token.txt

# ---- Movement detection (wakes up the screens) -----------------------------------------------------------------------------------------------
# The server looks for movement in the pictures of all cameras (the camera clients do not analyze anything, so a Raspberry Pi 3 is enough for a camera).
# While something moves, it tells all displays and all cameras with a screen to switch their screens on (screen_mode = auto in display.cfg / client.cfg).
motion = true

# How often the pictures of every camera are checked per second. Higher values react faster, but need more CPU.
motion_fps = 5

# How much of the picture (in percent) has to change to count as movement, and how much the brightness of a pixel (0 - 255) has to change.
motion_min_area = 1.0
motion_pixel_threshold = 25

# Changes of the lighting are not movement: a lamp (with its own motion sensor) turning on in front of a camera, the day/night (IR) mode of a camera, the
# automatic exposure of the camera adjusting afterwards. Such a change moves the brightness of the WHOLE picture, a person does not (the median of all
# pixels stays where it was, as long as the person covers less than half of the picture). The picture counts as a change of the lighting, if its
# brightness (0 - 255) changes by at least motion_light_shift at once, or at least motion_light_area percent of the picture changes at once. The background
# is learned again, and for at least motion_light_settle_seconds after it, no movement is reported (the camera needs a moment to adjust). 0 turns a check
# off (both 0: no lighting check). Lower values suppress more, but a person in front of a large part of the picture may be taken for a lamp.
# The log says "Change of the lighting at the camera ..." each time (at most every 10 seconds), look there if the screens do not wake up.
motion_light_shift = 8
motion_light_area = 50
motion_light_settle_seconds = 3

# ---- Face detection and recognition (off by default) ----------------------------------------------------------------------------------------
# Finds the faces in the camera feeds, and recognizes known people. It needs two model files and photos of the known people, see README.md
# ("Face detection and recognition"). Faces are marked in the preview windows, and reported in the log.
faces = false

# The model files (see CamServer/models/README.md). Without the recognizer model, faces are only detected.
face_detector_model = models/face_detection_yunet_2023mar.onnx
face_recognizer_model = models/face_recognition_sface_2021dec.onnx

# Folder with the photos of the known people: one folder per person (see CamServer/known_faces/README.md).
known_faces_path = known_faces

# How often the frames of every camera are analyzed per second. Higher values need more CPU.
face_fps = 3

# Minimum confidence of the detector (0 - 1). Lower values find more faces, but also more false ones. With 0.7 tires, door frames, handles and lamps are
# sometimes taken for faces (and then reported as "unknown person"). 0.9 is the value of the OpenCV examples. If real faces are missed (small or far
# away, night), lower it step by step (0.85, 0.8), and look at face_debug_crops to see what is reported.
face_score_threshold = 0.9

# Minimum similarity (-1 - 1) for a match with a known person. 0.363 is the value recommended by the authors of the model. Higher values are stricter:
# fewer wrong people, but more known people are reported as "unknown".
face_match_threshold = 0.363

# ---- Filters against false faces and false alarms (tune these, if the face_score_threshold alone is not enough) ------------------------------------
# A detection is dropped before recognition, if it cannot be a face. "CamServer --face_test=photo.jpg" lists the dropped detections and the reason.
# Smallest face in pixels (width and height): in the original picture, and in the scaled down picture (see face_detect_width). 0 = no limit.
# Small detections are mostly wrong, and real ones that small cannot be recognized reliably anyway.
face_min_size = 40
face_min_detect_size = 24

# Allowed ratio width / height of the face box. A face is about as wide as high.
face_min_aspect = 0.6
face_max_aspect = 1.3

# Checks the five points of the detector (eyes, nose, corners of the mouth): inside the box, eyes above the nose above the mouth, eyes next to each other.
face_check_landmarks = true

# A face has to be seen in at least face_confirm_frames of the last face_confirm_window analyses at about the same place, before it is shown and reported
# (one analysis takes 1 / face_fps seconds). This removes detections, which flicker for a single picture. 1 = no confirmation.
face_confirm_frames = 3
face_confirm_window = 5

# A face, which does not move at all for this many seconds, is part of the scene (for example a pattern at the door), not a person, and is ignored until
# it moves. Note: somebody sitting absolutely still in front of the camera is ignored after that time too. 0 = off.
face_static_seconds = 600

# The grey zone: a face with a similarity between face_uncertain_similarity and face_match_threshold is only an "unknown person" (alarm, email), if it is
# also reliable: at least face_reliable_size pixels wide and high, and a detector score of at least face_reliable_score. Otherwise it is "uncertain":
# shown in orange and written to the log, but no alarm. -1 turns the grey zone off.
face_uncertain_similarity = 0.25
face_reliable_size = 80
face_reliable_score = 0.95

# Photos of the known people are only used, if the detector is sure (score) and the face is large (pixels). A person with fewer photos than
# face_recommended_photos gets a warning in the log. 3 or more photos (different light, angle, glasses) recognize much better than one.
face_enroll_min_score = 0.9
face_enroll_min_size = 80
face_recommended_photos = 3

# Stores a crop (with a border) of every face, which causes an "unknown person" alarm, in face_snapshot_path/camera/crops. The similarity, the detector
# score and the size are in the file name. Look at them for a few days: wrong ones (tires, doors) have a low score or a strange shape, which tells
# you which of the settings above to change. Turn it off again afterwards.
face_debug_crops = false

# Frames are scaled down to this width for the detection (much faster). 0 = no scaling. Small faces far away are only found with larger values.
face_detect_width = 640

# A person, who stays in front of a camera, is reported once per this many seconds.
face_event_cooldown = 30

# Draws the faces (boxes and names) into the pictures, which are sent to the displays, like in the preview windows of the server.
# The pictures keep their frame rate, the boxes are those of the latest analysis (up to 1 / face_fps seconds old). false sends the plain pictures.
face_on_displays = true

# Draws the faces (boxes and names) into the videos, which are saved from the buffer of a camera (save in the web UI or the remote control,
# --record_now, an unknown person). Every frame gets the boxes of the analysis, which is nearest to it in time (face_fps per second), and frames without a
# face stay as they are. Drawing means decoding and compressing every frame with a face again, so saving a few minutes takes some seconds longer.
# false saves the pictures of the camera as they are. (The recording on a schedule is not affected, it writes the frames as they arrive.)
face_on_saved_clips = true

# ---- Emails about unknown people (off by default) -------------------------------------------------------------------------------------------
# Emails are sent for these events:
#   - an unknown person is seen by a camera (with the picture, in which the face is marked). Needs the face analysis above (faces = true, with the
#     recognizer model and at least one known person),
#   - a camera stops sending (it vanished without a goodbye), and when it is connected again. Does not need the face analysis (see email_camera_offline).
# The events are collected and sent together (see email_collect_seconds and email_min_interval), so there are no floods of emails.
# It needs curl (included in Windows 10 and 11, on Linux: sudo apt install curl). Check the settings with: CamServer --email_test (sends a test email).
email = false

# The mail server of your email provider (SMTP), and how to connect:
#   starttls : port 587 (the usual choice)    ssl : port 465 (encrypted from the start)    none : port 25, no encryption (only for a server in your own network)
email_smtp_server = smtp.example.com
email_smtp_port = 587
email_security = starttls

# The login at the mail server (usually the email address). Many providers (Gmail, Outlook, ...) require an "app password" instead of your normal
# password: create one in the security settings of your account. Leave both empty, if the server needs no login.
# Safer than writing the password into this file: set it in the environment variable CAMVISION_EMAIL_PASSWORD, it overrides email_password.
email_user = camvision@example.com
email_password =

# The sender, and the recipients (one address, or several separated by commas). Most providers require that the sender is your own address.
email_from = camvision@example.com
email_to = owner@example.com

# Written in front of the subject of every email.
email_subject_prefix = [CamVision]

# Attaches the picture with the marked face to the email.
email_attach_snapshot = true

# true: events are collected and sent together (see the next settings). false: every single event is sent as an email of its own (the emails are
# still spaced by email_min_interval, an event in the meantime waits for its turn and is not dropped; set email_min_interval = 0 for immediate emails).
email_batch = true

# (Only with email_batch = true.) The first event starts a collection window of this many seconds. Everything that happens in this time is sent in ONE email: an unknown person,
# who walks past two cameras, or several cameras, which go offline together (a power cut), are one email with a list. 0 sends every event on its own.
email_collect_seconds = 10

# At most one email per this many seconds. Nothing is lost: with email_batch = true events in between are collected and sent together with the next
# email, with email_batch = false they are sent one by one afterwards.
email_min_interval = 60

# The maximum number of pictures in one email. The pictures of different cameras come first.
email_max_attachments = 4

# Sends an email, when a camera stops sending, and when it comes back. A camera, which vanishes (no message for client_timeout_seconds, power or network
# is gone), is reported. A camera, which shuts down properly (it says goodbye), is not.
email_camera_offline = true

# Checks the certificate of the mail server. Only set this to false for a server in your own network with a self signed certificate.
email_verify_certificate = true

# The curl program (a different path, if it is not found), and how long sending an email may take, in seconds.
email_curl_path = curl
email_timeout = 60

# Stores a photo with the marked faces, whenever somebody is reported. One folder per camera inside face_snapshot_path.
face_snapshots = false
face_snapshot_path = faces
