# Copy this file to display.cfg (in the folder, in which the display is started). Every setting can also be given as --key=value on the command line,
# which overrides this file. Use --config=path to load a different file. Settings that are not set use the defaults shown here.

# Address and port of the server, which the display connects to. The port is the one of the camera server (45645 by default).
server_ip = 127.0.0.1
server_port = 45645

# The key of this display. Make it on the computer of the server with
#   CamServer --add_device=display --name="Living room"
# which prints the line to put here. With the key, the connection to the server is authenticated and encrypted: nobody else can see the pictures. The
# server does not talk to a display without a key (unless auth = false in server.cfg). The key is a secret: whoever has it can see all cameras.
key =

# The name of this display, shown in the log of the server. With device keys, the server uses the name, which the display got with --add_device.
name = Display #1

# The one camera, which this display shows (the name of the camera, as set with "name" in client.cfg), fullscreen.
# Empty shows all cameras next to each other: 1 camera fills the screen, 2 are side by side, 4 are 2 x 2, and so on.
camera =

# The maximum number of frames per second the display receives from every camera. Fewer frames save network bandwidth and CPU on a weak device
# (a Raspberry Pi 3 with several cameras on Wi-Fi: try 5).
max_fps = 10

# What happens to the screen. "on" (default): the display does not touch it, the system decides when it goes to sleep (a touch wakes it up).
# "auto": the display switches the screen on as soon as a camera sees movement (the server tells all displays), and off after screen_timeout seconds
# without movement. A touch wakes it up too. The movement is detected by the server (motion = true in server.cfg, the default). On Linux it uses xset (or vcgencmd), on Windows the monitor power message.
screen_mode = on
screen_timeout = 60

# Own commands to switch the screen on and off in auto mode, if the defaults do not work (for example on Wayland). Empty uses the defaults.
# screen_on_command = wlr-randr --output HDMI-A-1 --on
# screen_off_command = wlr-randr --output HDMI-A-1 --off

# The display always covers the whole screen, without a border or a title bar. Esc (or Q) shuts it down.

# The size of the picture, if the display is started with --save_snapshot (for testing without a screen).
window_width = 1280
window_height = 720
